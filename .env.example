# AWS Configuration
AWS_REGION=us-east-1
# AWS_PROFILE=default
# Optional: use a Bedrock long-term API key instead of AWS credentials
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key

# Translation Configuration
DEFAULT_TARGET_LANGUAGE=ko
MANTLE_MODEL_ID=openai.gpt-5.6-terra
MANTLE_ENABLE_MODEL_FALLBACK=true
MANTLE_FALLBACK_MODEL_ID=openai.gpt-5.6-luna

# Translation Settings
MAX_TOKENS=2000
TEMPERATURE=0.1
OPENAI_REASONING_EFFORT=none
BEDROCK_MANTLE_TIMEOUT_SECONDS=300
ENABLE_POLISHING=true
BATCH_SIZE=20
CONTEXT_THRESHOLD=5
BATCH_WORKERS=10
SLIDE_WORKERS=4
SLIDES_PER_WORKER=30

# PowerPoint-to-Markdown
MARKDOWN_WORKERS=4
MARKDOWN_SLIDES_PER_CHUNK=10
MARKDOWN_MAX_TOKENS=3000
MARKDOWN_OVERVIEW_MAX_TOKENS=2000
MARKDOWN_WEB_MAX_TOKENS=1500
MARKDOWN_MAX_WEB_QUERIES=3
MARKDOWN_SEARCH_RESULTS_PER_QUERY=5
MARKDOWN_REASONING_EFFORT=low

# Font Settings by Language
FONT_KOREAN=맑은 고딕
FONT_JAPANESE=Yu Gothic UI
FONT_ENGLISH=Amazon Ember
FONT_CHINESE=Microsoft YaHei
FONT_DEFAULT=Arial

# Debug Settings
DEBUG=false

# Post-processing Settings
ENABLE_TEXT_AUTOFIT=true
TEXT_LENGTH_THRESHOLD=10
